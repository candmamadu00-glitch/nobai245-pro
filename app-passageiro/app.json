{
  "expo": {
    "name": "Nobai245 Passageiro",
    "slug": "nobai245-passageiro",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mamadubalde.nobai245passageiro",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Permita o acesso à localização para podermos enviar o motorista até si.",
        "NSLocationWhenInUseUsageDescription": "Sua localização é necessária para encontrar motoristas próximos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E243C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.mamadubalde.nobai245passageiro",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Nô Bai 245",
      "shortName": "Nô Bai 245",
      "description": "Peça sua corrida rápida e segura na Guiné-Bissau.",
      "themeColor": "#0E243C",
      "backgroundColor": "#0E243C"
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "sk.eyJ1IjoibWFtYWR1Y2FuZGUiLCJhIjoiY211ZTRyc3NmMDBzMTJ5cTA1anJvYjFsOSJ9.pUAoGXwZS8FtYNr85VD1TA"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 36,
            "enableProguardInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita o acesso à localização para encontrar motoristas próximos e acompanhar sua viagem.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o uso da câmera para verificação de perfil ou documentos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E243C",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E243C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E243C"
          }
        }
      ],
      "expo-asset",
      "expo-audio",
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "98d4d827-efe4-41f3-a5f5-2d8ff1c47dcb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "url": "https://u.expo.dev/98d4d827-efe4-41f3-a5f5-2d8ff1c47dcb"
    }
  }
}
