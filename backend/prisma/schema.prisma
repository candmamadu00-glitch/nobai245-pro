// ==========================================
// 🛡️ COFRE NO BAI 245 - SCHEMA ENTERPRISE BLINDADO (V3.0)
// ==========================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  SUPER_ADMIN
  OPERATOR
  FINANCE
  SUPPORT
}

enum MobileMoneyProvider {
  ORANGE_MONEY
  MTN_MOMO
}

enum DocumentType {
  BI
  PASSPORT
  MIGRATORY_CARD
}

enum VehicleType {
  PARTICULAR
  TAXI
  MOTO
  MOTO_CARRO
  TOCA_TOCA
}

enum DriverStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
  BANNED
}

enum PassengerStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  BANNED
}

enum ServiceType {
  RIDE
  DELIVERY
  RENTAL
}

enum RideStatus {
  PENDING
  SCHEDULED
  SEARCHING
  QUEUED
  AWAITING_PAYMENT
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  TIMEOUT
}

enum PaymentMethod {
  ORANGE_MONEY
  MTN_MOMO
  WALLET
  CASH
  CARD
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  RIDE_PAYMENT
  COMMISSION_FEE
  DRIVER_PAYOUT
  PAYOUT
  REFUND
  MANUAL_RECHARGE
  PROMO_CREDIT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  PENDING_VERIFICATION
  HELD_IN_ESCROW
  COMPLETED
  FAILED
  FAILED_MANUAL_REVIEW
  CANCELLED
  REVERSED
}

enum UserType {
  PASSENGER
  DRIVER
  ADMIN
  SYSTEM
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SosStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

enum PaymentIntentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TicketCategory {
  LOST_ITEM
  CHARGE_DISPUTE
  CONDUCT_REPORT
  APP_BUG
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// 🧑‍💼 USUÁRIOS E ADMINISTRAÇÃO
// ==========================================

model Admin {
  id                String          @id @default(uuid()) @db.Uuid
  name              String          @db.VarChar(100)
  email             String          @unique @db.VarChar(100)
  passwordHash      String
  resetTokenHash    String?         @db.VarChar(100)
  resetTokenExpires DateTime?
  lastResetAttempt  DateTime?
  role              Role            @default(OPERATOR)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  auditLogs         AdminAuditLog[]
  tickets           Ticket[]        @relation("AdminAssignedTickets")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(50)
  targetId   String?  @db.VarChar(100)
  ipAddress  String?  @db.VarChar(45)
  payload    Json?
  createdAt  DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Passenger {
  id                   String               @id @default(uuid()) @db.Uuid
  fullName             String               @db.VarChar(100)
  phone                String               @unique @db.VarChar(20)
  email                String?              @unique
  resetTokenHash       String?              @db.VarChar(100)
  resetTokenExpires    DateTime?
  lastResetAttempt     DateTime?
  passwordHash         String
  profilePicture       String?
  documentType         DocumentType?
  documentNumber       String?              @unique @db.VarChar(50)
 
  walletBalance        Decimal              @default(0.00) @db.Decimal(12, 2)
  lockedBalance        Decimal              @default(0.00) @db.Decimal(12, 2)
  isVerified           Boolean              @default(false)
  status               PassengerStatus      @default(ACTIVE)

  ratingAverage        Decimal              @default(5.00) @db.Decimal(3, 2)
  totalRatings         Int                  @default(0)

  paymentProvider      MobileMoneyProvider?
  paymentAccountNumber String?              @db.VarChar(20)

  refreshTokenHash     String?              @db.Text
  otpCodeHash          String?              @db.VarChar(100)
  otpExpiresAt         DateTime?
  deviceToken          String?

  currentRideId        String?              @unique @db.Uuid
  currentRide          Ride?                @relation("PassengerActiveRide", fields: [currentRideId], references: [id], onDelete: SetNull)

  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  version              Int                  @default(0)

  rides                Ride[]               @relation("PassengerRidesHistory")
  transactions         Transaction[]
  emergencyContacts    EmergencyContact[]
  sosAlerts            SosAlert[]
  accountDeletionRequests AccountDeletionRequest[]
  paymentIntents       PaymentIntent[]
  tickets              Ticket[]             @relation("PassengerTickets")
  usedPromoCodes       PassengerPromoCode[]

  @@index([phone])
  @@index([status])
  @@index([deletedAt])
}

model Driver {
  id                   String               @id @default(uuid()) @db.Uuid
  fullName             String               @db.VarChar(100)
  phone                String               @unique @db.VarChar(20)
  passwordHash         String
  resetTokenHash       String?              @db.VarChar(100)
  resetTokenExpires    DateTime?
  lastResetAttempt     DateTime?
  profilePicture       String?
  licenseFrontPicture  String?
  licenseBackPicture   String?
  orangeNumber         String?              @db.VarChar(20)
  mtnNumber            String?              @db.VarChar(20)
  paymentAccountNumber String?              @db.VarChar(20)
  version              Int                  @default(0)

  isOnline             Boolean              @default(false)
  isAvailable          Boolean              @default(true)
  lastLat              Float?
  lastLng              Float?
  lastLocationUpdate   DateTime?
  currentHeading       Float?

  ratingAverage        Decimal              @default(5.00) @db.Decimal(3, 2)
  totalRatings         Int                  @default(0)

  vehicleType          VehicleType
  vehicleBrand         String               @db.VarChar(50)
  vehiclePlate         String               @unique @db.VarChar(20)
  vehicleColor         String               @db.VarChar(30)
  vehicleSeats         Int?

  documentType         DocumentType
  documentNumber       String               @unique @db.VarChar(50)

  licenseExpiresAt     DateTime?
  carteGrisePicture    String?
  insurancePicture     String?
  insuranceExpiresAt   DateTime?

  status               DriverStatus         @default(PENDING_APPROVAL)
  walletBalance        Decimal              @default(0.00) @db.Decimal(12, 2)
  pendingBalance       Decimal              @default(0.00) @db.Decimal(12, 2)

  refreshTokenHash     String?              @db.Text
  otpCodeHash          String?              @db.VarChar(100)
  otpExpiresAt         DateTime?
  deviceToken          String?

  currentRideId        String?              @unique @db.Uuid
  currentRide          Ride?                @relation("DriverActiveRide", fields: [currentRideId], references: [id], onDelete: SetNull)

  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  rides                Ride[]               @relation("DriverRidesHistory")
  rideOffers           RideOffer[]
  transactions         Transaction[]
  paymentIntents        PaymentIntent[]
  sosAlerts            SosAlert[]
  changeRequests       DriverChangeRequest[]
  accountDeletionRequests AccountDeletionRequest[]
  tickets              Ticket[]             @relation("DriverTickets")
  sosIncidents         SosIncident[]

  @@index([status, isOnline, isAvailable])
  @@index([lastLat, lastLng, isAvailable])
  @@index([phone])
  @@index([orangeNumber])
  @@index([mtnNumber])
  @@index([deletedAt])
  fleetPartnerLink     FleetPartnerDriver?
}

// ==========================================
// 🚗 CICLO DE VIDA DA CORRIDA (RIDE SYSTEM)
// ==========================================

model Ride {
  id                   String               @id @default(uuid()) @db.Uuid
  passengerId          String               @db.Uuid
  driverId             String?              @db.Uuid
  version              Int                  @default(0)
  serviceType          ServiceType          @default(RIDE)
  rentalHours          Int?
  rentalDays           Int?
  requestedVehicleType VehicleType          @default(PARTICULAR)
  paymentMethod        PaymentMethod        @default(CASH)
 
  scheduledAt          DateTime?
  expiresAt            DateTime?

  // Entrega (Delivery)
  recipientName        String?              @db.VarChar(100)
  recipientPhone       String?              @db.VarChar(20)
  packageNotes         String?              @db.Text
  pickupPhotoUrl       String?              @db.Text
  deliveryPhotoUrl     String?              @db.Text

  // Geo-dados
  originAddress        String
  originLat            Float
  originLng            Float
  stops                Json?
  destinationAddress   String
  destinationLat       Float
  destinationLng       Float
  distanceKm           Decimal?             @db.Decimal(8, 2)
  durationMin          Int?

  referencePoint       String?
  startOtp             String?              @db.VarChar(4)
  finishOtp            String?              @db.VarChar(4)
  shareToken           String?              @unique @db.VarChar(100)

  // Financeiro e Billing
  estimatedPriceXof    Decimal              @default(0.00) @db.Decimal(10, 2)
  priceXof             Decimal              @db.Decimal(10, 2)
  platformFee          Decimal?             @db.Decimal(10, 2)
  driverEarnings       Decimal?             @db.Decimal(10, 2)
  promoCodeId          String?              @db.Uuid
  discountAmount       Decimal?             @default(0.00) @db.Decimal(10, 2)
 
  // Snapshots
  driverVehiclePlate   String?              @db.VarChar(20)
  driverVehicleType    VehicleType?

  // Controle de Estado
  status               RideStatus           @default(SEARCHING)

  cancellationReason   String?              @db.Text
  cancelledBy          UserType?
  cancelledById        String?              @db.Uuid
  cancelledAt          DateTime?
  cancellationFeeApplied Decimal?           @default(0.00) @db.Decimal(10, 2)

  // Timestamps de Fluxo
  acceptedAt           DateTime?
  arrivedAt            DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  
  // Controle de Dispatch
  rejectedByDriverIds  String[]             @default([])

  // Relações
  passenger            Passenger            @relation("PassengerRidesHistory", fields: [passengerId], references: [id], onDelete: Restrict)
  driver               Driver?              @relation("DriverRidesHistory", fields: [driverId], references: [id], onDelete: Restrict)
  activePassenger      Passenger?           @relation("PassengerActiveRide")
  activeDriver         Driver?              @relation("DriverActiveRide")
  promoCode            PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  offers               RideOffer[]
  ratings              Rating[]
  transactions         Transaction[]
  locationHistory      RideLocationHistory[]
  eventLogs            RideEventLog[]
  sosAlerts            SosAlert[]
  chatMessages         RideChatMessage[]
  callLogs             RideCallLog[]
  tickets              Ticket[]
  sosIncidents         SosIncident[]

  @@index([status])
  @@index([passengerId, status, createdAt])
  @@index([driverId, status, createdAt])
}

// ==========================================
// 📡 SISTEMA DE DESPACHO E OFERTAS
// ==========================================
model RideOffer {
  id        String          @id @default(uuid()) @db.Uuid
  rideId    String          @db.Uuid
  driverId  String          @db.Uuid
  status    RideOfferStatus @default(PENDING)
  expiresAt DateTime
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  ride      Ride            @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver    Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverId])
  @@index([driverId, status, expiresAt])
  @@index([rideId, status])
}

model RideEventLog {
  id          String     @id @default(uuid()) @db.Uuid
  rideId      String     @db.Uuid
  status      RideStatus
  triggeredBy UserType   @default(SYSTEM)
  userId      String?    @db.Uuid
  lat         Float?
  lng         Float?
  metadata    Json?
  createdAt   DateTime   @default(now())

  ride        Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
}

model RideLocationHistory {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @db.Uuid
  lat       Float
  lng       Float
  heading   Float?   @default(0)
  speed     Float?   @default(0)
  accuracy  Float?
  createdAt DateTime @default(now())

  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
}

// ==========================================
// 💳 FINANCEIRO & CONFIGURAÇÕES
// ==========================================

model PromoCode {
  id                 String               @id @default(uuid()) @db.Uuid
  code               String               @unique @db.VarChar(50)
  description        String?              @db.VarChar(255)
  discountPercentage Decimal?             @db.Decimal(5, 2)
  discountFixed      Decimal?             @db.Decimal(10, 2)
  maxDiscountAmount  Decimal?             @db.Decimal(10, 2)
  minRideAmount      Decimal?             @default(0.00) @db.Decimal(10, 2)
  maxUsageTotal      Int?
  currentUsage       Int                  @default(0)
  maxUsagePerUser    Int                  @default(1)
  expiresAt          DateTime?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())

  rides              Ride[]
  usedBy             PassengerPromoCode[]
 
  @@index([code, isActive])
}

model PassengerPromoCode {
  id          String    @id @default(uuid()) @db.Uuid
  passengerId String    @db.Uuid
  promoCodeId String    @db.Uuid
  usedCount   Int       @default(0)
  lastUsedAt  DateTime  @default(now())

  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([passengerId, promoCodeId])
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  passengerId    String?           @db.Uuid
  driverId       String?           @db.Uuid
  rideId         String?           @db.Uuid
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  paymentMethod  PaymentMethod?
  amount         Decimal           @db.Decimal(12, 2)

  balanceBefore  Decimal?          @db.Decimal(12, 2)
  balanceAfter   Decimal?          @db.Decimal(12, 2)

  reference      String            @unique
  externalRef    String?           @unique
  idempotencyKey String?           @unique @db.VarChar(100)
  description    String?

  failureReason  String?           @db.Text
  version        Int               @default(0)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  passenger      Passenger?        @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  driver         Driver?           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  ride           Ride?             @relation(fields: [rideId], references: [id], onDelete: Restrict)
  paymentIntent  PaymentIntent?

  @@index([status, type])
  @@index([passengerId, createdAt])
  @@index([driverId, createdAt])
  @@index([rideId])
  @@index([reference])
}

model PaymentIntent {
  id            String              @id @default(uuid()) @db.Uuid
  passengerId   String?             @db.Uuid
  driverId      String?             @db.Uuid
  userType      UserType            @default(PASSENGER)
  transactionId String?             @unique @db.Uuid
  rideId        String?             @db.Uuid
  provider      MobileMoneyProvider
  phone         String              @db.VarChar(20)
  amount        Decimal             @db.Decimal(12, 2)
  reference     String              @unique @db.VarChar(100)
  status        PaymentIntentStatus @default(PENDING)

  rawResponse   Json?
  failureReason String?             @db.Text

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  passenger     Passenger?          @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  driver        Driver?             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  transaction   Transaction?        @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([reference])
  @@index([status])
  @@index([driverId])
}

model TariffConfig {
  id                  String      @id @default(uuid()) @db.Uuid
  vehicleType         VehicleType
  serviceType         ServiceType @default(RIDE)
  baseFare            Decimal     @db.Decimal(10, 2)
  perKmFare           Decimal     @db.Decimal(10, 2)
  perMinuteFare       Decimal     @db.Decimal(10, 2)
  minimumFare         Decimal     @db.Decimal(10, 2)
  commissionRate      Decimal     @db.Decimal(5, 2)
  cancellationFeeBase Decimal     @default(500.00) @db.Decimal(10, 2)
  surgeMultiplier     Decimal     @default(1.00) @db.Decimal(4, 2)
  isActive            Boolean     @default(true)
  updatedAt           DateTime    @updatedAt

  @@unique([vehicleType, serviceType])
}

model SystemConfig {
  id                    String   @id @default("bai245-system-config") @db.VarChar(50)
  adminOrangeNumber     String   @default("245950000000") @db.VarChar(20)
  adminMtnNumber        String   @default("245960000000") @db.VarChar(20)
  adminMerchantCode     String   @default("72447321") @db.VarChar(30)
  companyName           String   @default("NÔ BAI 245") @db.VarChar(80)
  defaultCommissionRate Decimal  @default(15.00) @db.Decimal(5, 2)
  globalSurgeActive     Boolean  @default(false)
  globalSurgeMultiplier Decimal  @default(1.00) @db.Decimal(4, 2)
  minDriverBalanceXof   Decimal  @default(0.00) @db.Decimal(12, 2)
  autoBlockExpiredDocs  Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model CompanyWallet {
  id             String   @id @default("bai245-main-wallet") @db.VarChar(50)
  balance        Decimal  @default(0.00) @db.Decimal(12, 2)
  totalCollected Decimal  @default(0.00) @db.Decimal(12, 2)
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// ==========================================
// 🛡️ SUPORTE, COMUNICAÇÃO E WEBHOOKS
// ==========================================

model Rating {
  id           String   @id @default(uuid()) @db.Uuid
  rideId       String   @db.Uuid
  reviewerId   String   @db.Uuid
  reviewerType UserType
  receiverId   String   @db.Uuid
  stars        Int      @default(5)
  tags         String[] @default([])
  comment      String?  @db.Text
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())

  ride         Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, reviewerId])
  @@index([receiverId, stars])
}

model RideChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  rideId     String   @db.Uuid
  senderId   String   @db.Uuid
  senderType UserType
  message    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
}

model RideCallLog {
  id          String   @id @default(uuid()) @db.Uuid
  rideId      String   @db.Uuid
  callerId    String   @db.Uuid
  callerType  UserType
  receiverId  String   @db.Uuid
  durationSec Int?
  createdAt   DateTime @default(now())

  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
}

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @db.VarChar(50)
  eventId     String   @unique @db.VarChar(100)
  payload     Json
  isProcessed Boolean  @default(false)
  errorLog    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([isProcessed, createdAt])
}

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @db.VarChar(100)
  payload     Json
  isProcessed Boolean  @default(false)
  retryCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isProcessed, createdAt])
}

// ==========================================
// 📍 MAPEAMENTO TERRITORIAL DE BISSAU
// ==========================================

model Neighborhood {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(100)
  city      String        @default("Bissau") @db.VarChar(50)
  centerLat Float?
  centerLng Float?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  places    CustomPlace[]

  @@index([name])
}

model CustomPlace {
  id             String       @id @default(uuid()) @db.Uuid
  neighborhoodId String       @db.Uuid
  name           String       @db.VarChar(150)
  popularName    String?      @db.VarChar(100)
  searchKeywords String[]     @default([])
  referenceNotes String?      @db.Text
  latitude       Float
  longitude      Float
  isActive       Boolean      @default(true)
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
  @@index([latitude, longitude])
  @@index([name])
}

model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  passengerId  String   @db.Uuid
  name         String   @db.VarChar(100)
  phone        String   @db.VarChar(20)
  relationship String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  passenger    Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([passengerId])
}

model SosAlert {
  id          String    @id @default(uuid()) @db.Uuid
  rideId      String?   @db.Uuid
  userType    UserType
  passengerId String?   @db.Uuid
  driverId    String?   @db.Uuid
  lat         Float
  lng         Float
  status      SosStatus @default(ACTIVE)
  audioUrl    String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ride        Ride?      @relation(fields: [rideId], references: [id], onDelete: SetNull)
  passenger   Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  driver      Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([rideId])
}

model SosIncident {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @db.Uuid
  driverId  String   @db.Uuid
  audioUrl  String?  @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([driverId])
}

model AccountDeletionRequest {
  id          String        @id @default(uuid()) @db.Uuid
  passengerId String?       @db.Uuid
  driverId    String?       @db.Uuid
  reason      String?       @db.Text
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  passenger   Passenger? @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  driver      Driver?    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([passengerId])
  @@index([driverId])
}

model DriverChangeRequest {
  id                String        @id @default(uuid()) @db.Uuid
  driverId          String        @db.Uuid
  newFullName       String?       @db.VarChar(100)
  newVehiclePlate   String?       @db.VarChar(20)
  newVehicleBrand   String?       @db.VarChar(50)
  newVehicleColor   String?       @db.VarChar(30)
  newDocumentNumber String?       @db.VarChar(50)
  status            RequestStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  driver            Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([status])
}

model Ticket {
  id              String         @id @default(uuid()) @db.Uuid
  passengerId     String?        @db.Uuid
  passenger       Passenger?     @relation("PassengerTickets", fields: [passengerId], references: [id], onDelete: Cascade)

  driverId        String?        @db.Uuid
  driver          Driver?        @relation("DriverTickets", fields: [driverId], references: [id], onDelete: Cascade)

  rideId          String?        @db.Uuid
  ride            Ride?          @relation(fields: [rideId], references: [id], onDelete: SetNull)

  createdByType   UserType       @default(DRIVER)
  category        String         @db.VarChar(100)
  priority        TicketPriority @default(MEDIUM)
  description     String         @db.Text
  status          TicketStatus   @default(OPEN)

  assignedAdminId String?        @db.Uuid
  assignedAdmin   Admin?         @relation("AdminAssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        TicketMessage[]

  @@index([passengerId])
  @@index([driverId])
  @@index([rideId])
  @@index([status, priority, createdAt])
  @@index([assignedAdminId])
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    UserType
  senderId  String   @db.Uuid
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// =========================================================
// 🏢 MÓDULOS DE ESCALA EMPRESARIAL (B2B, FROTISTAS, ANTIFRAUDE, ZONAS, MISSÕES)
// =========================================================

model CorporateAccount {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(120)
  taxId             String?             @db.VarChar(50)
  contactName       String?             @db.VarChar(100)
  contactPhone      String              @db.VarChar(30)
  contactEmail      String?             @db.VarChar(100)
  creditLimitXof    Decimal             @default(0.00) @db.Decimal(12, 2)
  currentBalanceXof Decimal             @default(0.00) @db.Decimal(12, 2)
  costCenter        String?             @db.VarChar(80)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  employees         CorporateEmployee[]
}

model CorporateEmployee {
  id              String           @id @default(uuid()) @db.Uuid
  corporateId     String           @db.Uuid
  fullName        String           @db.VarChar(100)
  phone           String           @db.VarChar(25)
  department      String?          @db.VarChar(80)
  monthlyLimitXof Decimal?         @db.Decimal(12, 2)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  corporate       CorporateAccount @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@unique([corporateId, phone])
  @@index([phone])
}

model FleetPartner {
  id                String               @id @default(uuid()) @db.Uuid
  ownerName         String               @db.VarChar(120)
  phone             String               @unique @db.VarChar(25)
  email             String?              @db.VarChar(100)
  documentNumber    String?              @db.VarChar(50)
  orangeNumber      String?              @db.VarChar(25)
  mtnNumber         String?              @db.VarChar(25)
  ownerSharePercent Decimal              @default(50.00) @db.Decimal(5, 2)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  vehicles          FleetPartnerDriver[]
}

model FleetPartnerDriver {
  id         String       @id @default(uuid()) @db.Uuid
  partnerId  String       @db.Uuid
  driverId   String       @unique @db.Uuid
  assignedAt DateTime     @default(now())

  partner    FleetPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  driver     Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model BlacklistEntry {
  id              String   @id @default(uuid()) @db.Uuid
  identifierType  String   @db.VarChar(30)
  identifierValue String   @db.VarChar(120)
  reason          String   @db.VarChar(255)
  blockedBy       String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([identifierType, identifierValue])
  @@index([identifierValue])
}

model TariffZone {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  zoneType      String   @default("FIXED_ROUTE") @db.VarChar(30)
  centerLat     Decimal? @db.Decimal(10, 7)
  centerLng     Decimal? @db.Decimal(10, 7)
  radiusKm      Decimal  @default(2.00) @db.Decimal(6, 2)
  fixedPriceXof Decimal? @db.Decimal(10, 2)
  multiplier    Decimal  @default(1.00) @db.Decimal(4, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model DriverMission {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  targetRides Int      @default(10)
  rewardXof   Decimal  @default(2000.00) @db.Decimal(10, 2)
  startsAt    DateTime @default(now())
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
