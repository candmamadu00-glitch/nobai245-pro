{
  "expo": {
    "name": "Nobai245 Motorista",
    "slug": "nobai245-motorista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mamadubalde.nobai245motorista",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Permita o rastreamento em segundo plano para manter a navegação da corrida ativa mesmo se você trocar de aplicativo.",
        "NSLocationWhenInUseUsageDescription": "Sua localização é necessária para que os passageiros encontrem você."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E243C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.mamadubalde.nobai245motorista",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
  "ACCESS_COARSE_LOCATION",
  "ACCESS_FINE_LOCATION",
  "ACCESS_BACKGROUND_LOCATION",
  "CAMERA",
  "RECORD_AUDIO",
  "FOREGROUND_SERVICE",
  "FOREGROUND_SERVICE_LOCATION",
  "WAKE_LOCK",
  "VIBRATE",
  "POST_NOTIFICATIONS",
  "USE_FULL_SCREEN_INTENT",
  "android.permission.ACCESS_COARSE_LOCATION",
  "android.permission.ACCESS_FINE_LOCATION",
  "android.permission.ACCESS_BACKGROUND_LOCATION",
  "android.permission.FOREGROUND_SERVICE",
  "android.permission.FOREGROUND_SERVICE_LOCATION",
  "android.permission.CAMERA",
  "android.permission.RECORD_AUDIO",
  "android.permission.MODIFY_AUDIO_SETTINGS",
  "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
  "android.permission.USE_FULL_SCREEN_INTENT"
]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "@rnmapbox/maps",
        {
          "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "sk.eyJ1IjoibWFtYWR1Y2FuZGUiLCJhIjoiY211ZTRyc3NmMDBzMTJ5cTA1anJvYjFsOSJ9.pUAoGXwZS8FtYNr85VD1TA"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 34,
            "kotlinVersion": "2.1.20",
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita o acesso à localização para rastrear rotas durante as corridas.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o uso da câmera para verificação de perfil ou documentos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E243C"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E243C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E243C"
          }
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1a0d202c-7545-4695-bb69-8bde59a94543"
      }
    }
  }
}
